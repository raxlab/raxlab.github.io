@inproceedings{Elaswad2026-ecmlpkdd,
	title = {Decision-Focused Learning for Operating Room Scheduling Under Uncertain Surgery Durations with Two-Stage Stochastic Optimization},
	booktitle = {Machine Learning and Knowledge Discovery in Databases. Research Track and Applied Data Science Track (ECML PKDD 2026)},
	editor = {Ceci, Michelangelo and Kocev, Dragi and Monreale, Anna and Vens, Celine and Baratchi, Mitra and Bonchi, Francesco and Guidotti, Riccardo and Gullo, Francesco and Flach, Peter and Manco, Giuseppe and Spiliopoulou, Myra and Masciari, Elio},
	series = {Lecture Notes in Computer Science},
	volume = {16948},
	pages = {252--270},
	publisher = {Springer},
	address = {Cham},
	year = {2027},
	isbn = {978-3-032-37679-4},
	issn = {1611-3349},
	doi = {10.1007/978-3-032-37679-4_15},
	url = {https://doi.org/10.1007/978-3-032-37679-4_15},
	author = {Ali Elaswad and Rodrigo A. Carrasco and Nourhan Sakr},
	abstract = {Operating rooms account for roughly 40\% of hospital expenses, making scheduling quality a primary lever for both cost control and patient access. Yet standard approaches either assume fixed surgery durations or decouple prediction from optimization, leaving systematic performance gains unrealized. We present a framework combining Smart Predict-Then-Optimize (SPO+) with two-stage stochastic programming (2SP) for OR scheduling under uncertain surgery durations. Duration predictors are trained end-to-end using a regret-aligned surrogate loss that directly optimizes downstream schedule quality, while a second-stage recourse mechanism adapts schedules in real time as true durations are revealed intraoperatively through opportunistic advancement, OR swaps, and cancellation. Four prediction pipelines are benchmarked on real neurosurgical data: a deterministic baseline, vanilla Predict-Then-Optimize, regret-aware gradient boosting, and SPO+, each evaluated with and without 2SP recourse via Monte Carlo simulation across utilization, overtime, and patient throughput. A penalty parameter $\lambda$ governing overtime cost serves as a governance-controlled policy knob, enabling explicit operationalization of institutional risk tolerance. SPO+ combined with 2SP recourse achieves 94.4\% OR utilization and reduces 95th-percentile overtime significantly compared to SPO+ alone.}
}
